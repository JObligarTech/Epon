# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#
# Local:  create .env.local next to this file.
# Vercel: Project → Settings → Environment Variables. Add to Production,
#         Preview and Development so preview deploys work too.

# ---------------------------------------------------------------- Supabase
# Supabase dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. This one is meant to be public — it ships to the
# browser by design. What protects data is row level security on every table,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role / secret key. Bypasses row level security entirely.
# Server-only, never prefixed NEXT_PUBLIC_, and not needed until Plaid
# webhooks arrive — a webhook has no user session to act on behalf of.
SUPABASE_SERVICE_ROLE_KEY=
