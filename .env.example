# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#
# Local:  create .env.local next to this file.
# Vercel: Project → Settings → Environment Variables. Add to Production,
#         Preview and Development so preview deploys work too.

# ---------------------------------------------------------------- Supabase
# Supabase dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. This one is meant to be public — it ships to the
# browser by design. What protects data is row level security on every table,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role / secret key. Bypasses row level security entirely.
# Server-only, never prefixed NEXT_PUBLIC_, and not needed until Plaid
# webhooks arrive — a webhook has no user session to act on behalf of.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Plaid
# Plaid dashboard → Developers → Keys

# Never prefixed NEXT_PUBLIC_. These are server-only: the client id and secret
# together can read every connected account, so they must never be inlined into
# a browser bundle. The browser only ever receives a short-lived link token.
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | production. Sandbox uses fake institutions and needs no approval.
PLAID_ENV=sandbox

# Where Plaid sends webhooks, e.g. https://your-app.vercel.app/api/plaid/webhook
# Leave empty locally: Plaid cannot reach localhost, and without it sync is
# manual only rather than broken.
PLAID_WEBHOOK_URL=

# Encrypts Plaid access tokens at rest, so a database dump without this key
# yields nothing usable. Generate a distinct one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating it makes every stored token undecryptable — connections would have
# to be re-linked. Treat it like a database password.
PLAID_TOKEN_ENCRYPTION_KEY=
